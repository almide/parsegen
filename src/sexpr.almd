// sexpr.almd — a parse Tree → tree-sitter's S-expression, canonical
// single-line form: named nodes only, hidden rules and synthetic nonterminals
// spliced into their parent, anonymous terminals dropped.
//
// PURE-RECURSIVE (returns the parts list instead of mutating one) — the wasm
// value-subset discipline. (Field labels are tracked in the Bnf but not
// printed at this rung — the json corpus's own expectations omit them.)

import self.normalize
import self.parse

fn render(bnf: normalize.Bnf, tree: parse.Tree) -> String = {
  let a = emit_list(bnf, tree.leading, 0, [])
  let b = emit_node(bnf, tree.root, a)
  let c = emit_list(bnf, tree.trailing, 0, b)
  list.join(c, " ")
}

// Append each node of `xs[i..]` to `parts`.
fn emit_list(bnf: normalize.Bnf, xs: List[parse.Cst], i: Int, parts: List[String]) -> List[String] =
  if i >= list.len(xs) then parts
  else {
    let x = list.get_or(xs, i, parse.Leaf(0, 0, 0))
    let parts2 = emit_node(bnf, x, parts)
    emit_list(bnf, xs, i + 1, parts2)
  }

// Append `node`'s rendering (zero or more parenthesized names) to `parts`.
fn emit_node(bnf: normalize.Bnf, node: parse.Cst, parts: List[String]) -> List[String] =
  match node {
    parse.Leaf(term, _, _) => {
      let named = list.get_or(bnf.term_named, term, 0)
      if named == 1 then parts + ["(" + list.get_or(bnf.term_display, term, "?") + ")"]
      else parts
    },
    parse.Inner(nt, children) => {
      let hidden = list.get_or(bnf.nt_hidden, nt, 1)
      if hidden == 1 then emit_list(bnf, children, 0, parts)
      else {
        let inner = emit_list(bnf, children, 0, [])
        let name = list.get_or(bnf.nt_display, nt, "?")
        if list.is_empty(inner) then parts + ["(" + name + ")"]
        else parts + ["(" + name + " " + list.join(inner, " ") + ")"]
      }
    },
  }
