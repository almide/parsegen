// grammar.almd — read tree-sitter's `src/grammar.json` into a rule tree.
//
// The input is the fully evaluated JSON that `tree-sitter generate` commits into
// every grammar repository — never `grammar.js` (see README: executing the DSL
// is a permanent non-goal). Seven top-level keys; A0 consumes `rules` and
// `extras` and requires `externals` to be empty.
//
// Written in the pure-recursive style (no accumulation loops, every fallible
// step on its own `let … !` line) — the shape the wasm value subset admits;
// the same discipline almide/dfa established.

import json

// One rule-body node, mirroring grammar.json's tagged objects.
type Rule =
  | RSym(String)
  | RStr(String)
  | RPat(String)
  | RBlank
  | RSeq(List[Rule])
  | RChoice(List[Rule])
  | RRepeat(Rule)
  | RRepeat1(Rule)
  | RToken(Rule)
  | RImmediate(Rule)
  | RPrec(Int, Rule)
  | RField(String, Rule)
  | RAlias(String, Bool, Rule)

// A whole grammar: parallel lists (name, body) in declaration order — the
// FIRST rule is the start symbol — plus the extras.
type Grammar = {
  rule_names: List[String],
  rule_bodies: List[Rule],
  extras: List[Rule],
}

fn read(text: String) -> Result[Grammar, String] = {
  let root = json.parse(text)!
  let rules = value.field(root, "rules")!
  let names = value.keys(rules)
  let bodies = read_bodies(rules, names, 0, [])!
  let extras_v = value.field(root, "extras")!
  let extras_list = value.as_array(extras_v)!
  let extras = read_list(extras_list, 0, [])!
  let externals_v = value.field(root, "externals")!
  let externals = value.as_array(externals_v)!
  guard list.is_empty(externals) else err("external scanners are not supported at this rung")
  ok(Grammar { rule_names: names, rule_bodies: bodies, extras: extras })
}

// The rule bodies for `names[i..]`, appended to `acc`.
fn read_bodies(rules: Value, names: List[String], i: Int, acc: List[Rule]) -> Result[List[Rule], String] =
  if i >= list.len(names) then ok(acc)
  else {
    let name = list.get_or(names, i, "")
    let rv = value.field(rules, name)!
    let r = read_rule(rv)!
    read_bodies(rules, names, i + 1, acc + [r])
  }

// Each element of a JSON array as a Rule, appended to `acc`.
fn read_list(vs: List[Value], i: Int, acc: List[Rule]) -> Result[List[Rule], String] =
  if i >= list.len(vs) then ok(acc)
  else {
    let v = list.get_or(vs, i, value.null())
    let r = read_rule(v)!
    read_list(vs, i + 1, acc + [r])
  }

// One tagged rule object → Rule. Unknown tags are an error, not a guess.
fn read_rule(v: Value) -> Result[Rule, String] = {
  let tv = value.field(v, "type")!
  let t = value.as_string(tv)!
  match t {
    "SYMBOL" => {
      let nv = value.field(v, "name")!
      let name = value.as_string(nv)!
      ok(RSym(name))
    },
    "STRING" => {
      let sv = value.field(v, "value")!
      let s = value.as_string(sv)!
      ok(RStr(s))
    },
    "PATTERN" => {
      let pv = value.field(v, "value")!
      let p = value.as_string(pv)!
      ok(RPat(p))
    },
    "BLANK" => ok(RBlank),
    "SEQ" => {
      let ms = read_members(v)!
      ok(RSeq(ms))
    },
    "CHOICE" => {
      let ms = read_members(v)!
      ok(RChoice(ms))
    },
    "REPEAT" => {
      let c = read_content(v)!
      ok(RRepeat(c))
    },
    "REPEAT1" => {
      let c = read_content(v)!
      ok(RRepeat1(c))
    },
    "TOKEN" => {
      let c = read_content(v)!
      ok(RToken(c))
    },
    "IMMEDIATE_TOKEN" => {
      let c = read_content(v)!
      ok(RImmediate(c))
    },
    "PREC" => read_prec(v),
    "PREC_LEFT" => read_prec(v),
    "PREC_RIGHT" => read_prec(v),
    "PREC_DYNAMIC" => read_prec(v),
    "FIELD" => {
      let nv = value.field(v, "name")!
      let name = value.as_string(nv)!
      let c = read_content(v)!
      ok(RField(name, c))
    },
    "ALIAS" => {
      let nv = value.field(v, "value")!
      let name = value.as_string(nv)!
      let bv = value.field(v, "named")!
      let named = value.as_bool(bv)!
      let c = read_content(v)!
      ok(RAlias(name, named, c))
    },
    other => err("unsupported rule type '${other}'"),
  }
}

// The `members` array of a SEQ/CHOICE.
fn read_members(v: Value) -> Result[List[Rule], String] = {
  let mv = value.field(v, "members")!
  let ms = value.as_array(mv)!
  read_list(ms, 0, [])
}

// The `content` child of the single-child wrappers.
fn read_content(v: Value) -> Result[Rule, String] = {
  let cv = value.field(v, "content")!
  read_rule(cv)
}

// PREC/PREC_LEFT/PREC_RIGHT/PREC_DYNAMIC collapse to the value + content at
// this rung: json's only precedence is lexical (inside a TOKEN), where the
// value orders tokenization; assoc distinctions only matter once a grammar
// declares conflicts (A2+).
fn read_prec(v: Value) -> Result[Rule, String] = {
  let pv = value.field(v, "value")!
  let p = value.as_int(pv) ?? 0
  let c = read_content(v)!
  ok(RPrec(p, c))
}
